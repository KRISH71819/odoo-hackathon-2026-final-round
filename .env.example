# ── DealFlow360 Environment Variables ──

# Database
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="dealflow360-dev-secret-change-in-production"
JWT_EXPIRES_IN="24h"

# API Server
API_PORT=3001
API_HOST=localhost

# Frontend
VITE_API_URL=http://localhost:3001/api

# Optional invite code for Sales Rep self-signup. Set a non-default secret in demo/production.
STAFF_SIGNUP_CODE=dealflow-staff-demo
