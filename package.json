{
  "name": "dealflow360",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:api": "pnpm --filter @dealflow360/api run dev",
    "dev:web": "pnpm --filter @dealflow360/web run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm --filter @dealflow360/api run test",
    "db:generate": "pnpm exec prisma generate",
    "db:migrate": "pnpm exec prisma migrate dev",
    "db:seed": "pnpm exec tsx prisma/seed.ts",
    "db:reset": "pnpm exec prisma migrate reset --force && pnpm exec tsx prisma/seed.ts",
    "db:studio": "pnpm exec prisma studio",
    "setup": "pnpm install && pnpm db:generate && pnpm exec prisma migrate dev --name init && pnpm db:seed"
  },
  "devDependencies": {
    "@prisma/client": "^6.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "bcrypt": "^5.1.1",
    "@types/bcrypt": "^5.0.2",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
